rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'projecty008@gmail.com';
    }

    match /artifacts/akyab-institute-batch-9-shared/public/data/exam_papers/{paperId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /artifacts/akyab-institute-batch-9-shared/public/data/student_roster/{studentId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /artifacts/akyab-institute-batch-9-shared/public/data/student_login_auth/{studentId} {
      // Exact-ID lookup only; plaintext passwords remain in the admin-only roster.
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /artifacts/akyab-institute-batch-9-shared/public/data/exam_submissions/{submissionId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'submissionId', 'ownerUid', 'studentId', 'studentName', 'submittedAt',
          'answers', 'autoScore', 'totalObjectivePossible', 'totalEssayPossible',
          'totalExamPossible', 'essayGraded', 'essayScore', 'adminRemarks'
        ])
        && request.resource.data.studentId is string
        && request.resource.data.studentName is string
        && request.resource.data.answers is map
        && request.resource.data.submittedAt is string
        && request.resource.data.autoScore is number
        && request.resource.data.totalObjectivePossible is number
        && request.resource.data.totalEssayPossible is number
        && request.resource.data.totalExamPossible == 100
        && request.resource.data.totalObjectivePossible + request.resource.data.totalEssayPossible == 100
        && request.resource.data.autoScore >= 0
        && request.resource.data.autoScore <= request.resource.data.totalObjectivePossible
        && request.resource.data.essayGraded == false
        && request.resource.data.essayScore == 0
        && request.resource.data.adminRemarks == ''
        && request.resource.data.studentId.size() <= 40
        && request.resource.data.studentName.size() <= 150
        && getAfter(/databases/$(database)/documents/artifacts/akyab-institute-batch-9-shared/public/data/exam_submission_status/$(request.resource.data.studentId)).data.submissionId == submissionId;

      allow get: if isAdmin()
        || (signedIn() && resource.data.ownerUid == request.auth.uid)
        || (signedIn()
          && get(/databases/$(database)/documents/artifacts/akyab-institute-batch-9-shared/public/data/exam_submission_status/$(resource.data.studentId)).data.submissionId == submissionId);

      allow list: if isAdmin()
        || (signedIn() && resource.data.ownerUid == request.auth.uid);

      allow update, delete: if isAdmin();
    }

    match /artifacts/akyab-institute-batch-9-shared/public/data/exam_submission_status/{studentId} {
      // This non-sensitive lock prevents a Student ID from submitting twice,
      // even from a different browser or device.
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create: if isAdmin() || (signedIn()
        && request.resource.data.keys().hasOnly([
          'studentId', 'ownerUid', 'submissionId', 'submittedAt'
        ])
        && request.resource.data.studentId == studentId
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.submissionId is string
        && request.resource.data.submittedAt is string
        && getAfter(/databases/$(database)/documents/artifacts/akyab-institute-batch-9-shared/public/data/exam_submissions/$(request.resource.data.submissionId)).data.ownerUid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Legacy plaintext credential documents are intentionally inaccessible.
    match /artifacts/akyab-institute-batch-9-shared/public/data/admin_config/{document=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
